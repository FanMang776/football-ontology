# 群星 FC 俱乐部声明数据（ABox）
# 全部是"白纸黑字写的事实"：阵容、合同、出场史、伤病。
# 位置建模：球员以类型成员身份挂最细位置类（ex:p_am1 a ex:AttackingMidfielder），
# 祖先位置成员关系由 subClassOf 闭包推理，不写 hasPosition 属性。
# 阵容为教学虚构：球员名来自现实球星，比赛/体能/伤停数据均为编造。
@prefix ex: <http://example.org/football#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

########## 俱乐部 ##########

ex:club_star a ex:Club ;
    rdfs:label "群星 FC"@zh .

########## 一线队（playsFor）##########

ex:p_gk1 a ex:Player, ex:Goalkeeper ; rdfs:label "阿利松"@zh ;
    ex:playsFor ex:club_star ;
    ex:hasContract ex:c_gk1 .
ex:p_gk2 a ex:Player, ex:Goalkeeper ; rdfs:label "库尔图瓦"@zh ;
    ex:playsFor ex:club_star ;
    ex:hasContract ex:c_gk2 .

ex:p_cb1 a ex:Player, ex:CentreBack ; rdfs:label "范戴克"@zh ;
    ex:playsFor ex:club_star ;
    ex:hasContract ex:c_cb1 ;
    ex:participatesIn ex:m_d1, ex:m_d2 ; ex:minutesPlayed 75, 60 ;
    ex:trainsIn ex:t_w1 .
ex:p_cb2 a ex:Player, ex:CentreBack ; rdfs:label "鲁本·迪亚斯"@zh ;
    ex:playsFor ex:club_star ;
    ex:hasContract ex:c_cb2 ;
    ex:participatesIn ex:m_d1 ; ex:minutesPlayed 75 .

ex:p_fb1 a ex:Player, ex:Fullback ; rdfs:label "阿诺德"@zh ;
    ex:playsFor ex:club_star ;
    ex:hasContract ex:c_fb1 ;
    ex:participatesIn ex:m_d1, ex:m_d2 ; ex:minutesPlayed 70, 65 .
ex:p_fb2 a ex:Player, ex:Fullback ; rdfs:label "特奥·埃尔南德斯"@zh ;
    ex:playsFor ex:club_star ;
    ex:hasContract ex:c_fb2 .

ex:p_dm1 a ex:Player, ex:DefensiveMidfielder ; rdfs:label "罗德里"@zh ;
    ex:playsFor ex:club_star ;
    ex:hasContract ex:c_dm1 ;
    ex:participatesIn ex:m_d1, ex:m_d2, ex:m_d3 ; ex:minutesPlayed 75, 65, 70 .

# 前腰双核：德布劳内连踢三场大强度 90/88/85（初始体能 56，过度使用告警的教学锚点；
# 注意 RDF 集合语义下重复值会塌缩，分钟数不能全同），
# B费腿筋拉伤伤停 4 周——本项目所有传导场景的起点。
ex:p_am1 a ex:Player, ex:AttackingMidfielder ; rdfs:label "德布劳内"@zh ;
    ex:playsFor ex:club_star ;
    ex:hasContract ex:c_am1 ;
    ex:participatesIn ex:m_d1, ex:m_d2, ex:m_d3 ; ex:minutesPlayed 90, 88, 85 .
ex:p_am2 a ex:Player, ex:AttackingMidfielder ; rdfs:label "B费"@zh ;
    ex:playsFor ex:club_star ;
    ex:hasContract ex:c_am2 ;
    ex:injuredWith ex:inj_am2 .

ex:p_wg1 a ex:Player, ex:Winger ; rdfs:label "维尼修斯"@zh ;
    ex:playsFor ex:club_star ;
    ex:hasContract ex:c_wg1 ;
    ex:participatesIn ex:m_d1 ; ex:minutesPlayed 70 ;
    ex:trainsIn ex:t_w1 .
ex:p_wg2 a ex:Player, ex:Winger ; rdfs:label "萨卡"@zh ;
    ex:playsFor ex:club_star ;
    ex:hasContract ex:c_wg2 ;
    ex:participatesIn ex:m_d2 ; ex:minutesPlayed 70 .

ex:p_st1 a ex:Player, ex:Striker ; rdfs:label "哈兰德"@zh ;
    ex:playsFor ex:club_star ;
    ex:hasContract ex:c_st1 ;
    ex:participatesIn ex:m_d1, ex:m_d2 ; ex:minutesPlayed 90, 75 ;
    ex:trainsIn ex:t_w1 .
ex:p_st2 a ex:Player, ex:Striker ; rdfs:label "姆巴佩"@zh ;
    ex:playsFor ex:club_star ;
    ex:hasContract ex:c_st2 ;
    ex:participatesIn ex:m_d2 ; ex:minutesPlayed 70 .
ex:p_st3 a ex:Player, ex:Striker ; rdfs:label "凯恩"@zh ;
    ex:playsFor ex:club_star ;
    ex:hasContract ex:c_st3 .

########## 青年队（squadOf；YouthPlayer ⊑ Player 由推理补全）##########

ex:p_ygk a ex:YouthPlayer, ex:Goalkeeper ; rdfs:label "马马达什维利"@zh ;
    ex:squadOf ex:club_star .
ex:p_ycb a ex:YouthPlayer, ex:CentreBack ; rdfs:label "库巴西"@zh ;
    ex:squadOf ex:club_star .
ex:p_yfb a ex:YouthPlayer, ex:Fullback ; rdfs:label "巴尔德"@zh ;
    ex:squadOf ex:club_star .
ex:p_yam1 a ex:YouthPlayer, ex:AttackingMidfielder ; rdfs:label "亚马尔"@zh ;
    ex:squadOf ex:club_star .
ex:p_yam2 a ex:YouthPlayer, ex:AttackingMidfielder ; rdfs:label "居莱尔"@zh ;
    ex:squadOf ex:club_star .
ex:p_yst a ex:YouthPlayer, ex:Striker ; rdfs:label "恩德里克"@zh ;
    ex:squadOf ex:club_star .

########## 合同 ##########

ex:c_gk1 a ex:Contract ; rdfs:label "阿利松的合同"@zh ; ex:contractYears 3 .
ex:c_gk2 a ex:Contract ; rdfs:label "库尔图瓦的合同"@zh ; ex:contractYears 2 .
ex:c_cb1 a ex:Contract ; rdfs:label "范戴克的合同"@zh ; ex:contractYears 4 .
ex:c_cb2 a ex:Contract ; rdfs:label "鲁本·迪亚斯的合同"@zh ; ex:contractYears 5 .
ex:c_fb1 a ex:Contract ; rdfs:label "阿诺德的合同"@zh ; ex:contractYears 3 .
ex:c_fb2 a ex:Contract ; rdfs:label "特奥·埃尔南德斯的合同"@zh ; ex:contractYears 2 .
ex:c_dm1 a ex:Contract ; rdfs:label "罗德里的合同"@zh ; ex:contractYears 5 .
ex:c_am1 a ex:Contract ; rdfs:label "德布劳内的合同"@zh ; ex:contractYears 1 .
ex:c_am2 a ex:Contract ; rdfs:label "B费的合同"@zh ; ex:contractYears 3 .
ex:c_wg1 a ex:Contract ; rdfs:label "维尼修斯的合同"@zh ; ex:contractYears 4 .
ex:c_wg2 a ex:Contract ; rdfs:label "萨卡的合同"@zh ; ex:contractYears 3 .
ex:c_st1 a ex:Contract ; rdfs:label "哈兰德的合同"@zh ; ex:contractYears 5 .
ex:c_st2 a ex:Contract ; rdfs:label "姆巴佩的合同"@zh ; ex:contractYears 2 .
ex:c_st3 a ex:Contract ; rdfs:label "凯恩的合同"@zh ; ex:contractYears 1 .

########## 比赛与训练 ##########

ex:m_d1 a ex:Match ; rdfs:label "联赛第 1 轮"@zh ; ex:matchday 1 .
ex:m_d2 a ex:Match ; rdfs:label "联赛第 2 轮"@zh ; ex:matchday 2 .
ex:m_d3 a ex:Match ; rdfs:label "联赛第 3 轮"@zh ; ex:matchday 3 .

ex:t_w1 a ex:TrainingSession ; rdfs:label "周中训练课"@zh ; ex:load 40 .

########## 伤病 ##########

ex:inj_am2 a ex:InjuryRecord ;
    rdfs:label "腿筋拉伤"@zh ;
    ex:weeksOut 4 .
